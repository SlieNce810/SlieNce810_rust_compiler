// ============================================================================
// SysY 词法规则（Lab1）
// ============================================================================
//
// 语法速查（pest 的 PEG 方言）：
//   rule  =  { ... }   普通规则：会出现在 Pair 树里；内部元素之间自动插空白
//   rule  = _{ ... }   静默规则：不进 Pair 树（相当于"展开"），内部仍自动插空白
//   rule  = @{ ... }   原子规则：不进 Pair 树内部，也不做隐式空白插入
//   rule  = ${ ... }   复合原子：不插空白，但内部子规则保留在树里
//   ~  序列     |  有序选择（第一个成功就停，不是最长匹配！）
//   *  +  ?    重复      !expr 负向前瞻    &expr 正向前瞻
//
// 内置规则：ANY SOI EOI NEWLINE ASCII_DIGIT ASCII_ALPHA ASCII_ALPHANUMERIC
//          ASCII_HEX_DIGIT ASCII_OCT_DIGIT ASCII_BIN_DIGIT ...
// ============================================================================


// ----------------------------------------------------------------------------
// 1. 顶层：永远不会失败的容错扫描
// ----------------------------------------------------------------------------
//
// 【要点】为什么不用 token* 而是 (token | unknown_char)* ？
//
//   如果用 `program = { SOI ~ token* ~ EOI }`，遇到第一个非法字符（比如 `~`）
//   整个 parse 就直接返回 Err，而且 pest 只告诉你"在哪个位置失败"，
//   拿不到第 2、第 3 个错误。可是实验要求"打印**所有**错误信息"。
//
//   加一条兜底规则 `unknown_char = @{ ANY }`（吃掉任意 1 个字符），
//   扫描就能一路走到底；真正的错误由 Rust 侧遍历 Pair 时收集。
//   这是用 pest 写词法器时最关键的一个技巧。
//
program = { SOI ~ (token | unknown_char)* ~ EOI }

// 具体 token 的分类入口。用 `_` 静默掉，这样 program 的直接子节点
// 就是 ident_or_kw / hex_int / ... / unknown_char，遍历时不用跳过中间层。
token = _{ ident_or_kw | integer_const | symbol }

// 兜底：吃掉 1 个无法识别的字符。必须是 atomic，否则 ANY 前面会先插空白。
unknown_char = @{ ANY }


// ----------------------------------------------------------------------------
// 2. 标识符 / 关键字
// ----------------------------------------------------------------------------
//
// 【要点】这里**故意不区分关键字**，全部先当标识符吃掉，关键字在 Rust 侧查表。
//
//   反例：如果把 `int_kw = { "int" }` 排在 IDENT 前面，输入 `intx` 会变成
//        INT("int") + IDENT("x")  —— PEG 是有序选择，不做最长匹配。
//   想靠文法修好，就得给 9 个关键字各加一条 `~(ASCII_ALPHANUMERIC | "_")`
//   的负向前瞻，又长又容易漏。
//
//   先按"字母/下划线开头，后跟字母数字下划线"整段吃掉，再去查关键字表——
//   这正是 flex/lex 这类真实词法器干的事（读 identifier → 查 keyword 表）。
//   好处：`intx` / `iffy` / `returns` 天然都是 IDENT，零特判。
//
ident_or_kw = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }


// ----------------------------------------------------------------------------
// 3. 整数字面量（十进制 / 八进制 / 十六进制）
// ----------------------------------------------------------------------------
//
// 【要点】三条规则的顺序不能调换，必须是 hex → oct → dec。
//
//   如果 dec 排最前：`0x1`  会被 dec 切成 "0"，剩下 "x1" 变 IDENT  ✗
//                    `077`  会被 dec 切成 "0" + "77" 两个 INTEGER_CONST ✗
//   如果 oct 排在 hex 前：`0x1` 里 "0" 后面跟 'x'，oct 的 ASCII_OCT_DIGIT 不含 x，
//                        于是 oct 匹配失败退回到 hex —— 这条其实没问题，
//                        但 oct 排 hex 前面会让规则顺序与直觉相反，容易看错。
//
//   注意 dec 放最后还有个副作用：`08` 会被 oct 拒掉、落到 dec 读成十进制 8。
//   严格 SysY 该报错，但讲义没要求，先放着（README 里记了这个取舍）。
//
integer_const = _{ hex_int | oct_int | dec_int }

hex_int = @{ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }   // 0x1 0Xab 0xFF
oct_int = @{ "0" ~ ASCII_OCT_DIGIT+ }                  // 077 02
dec_int = @{ ASCII_DIGIT+ }                            // 0 12 2147483647


// ----------------------------------------------------------------------------
// 4. 运算符与分隔符
// ----------------------------------------------------------------------------
//
// 【要点】同样是有序选择，**长符号必须排在它的前缀之前**：
//   "==" 在 "=" 前，否则 `a == b` 被切成 ASSIGN ASSIGN
//   "<=" 在 "<" 前、"!=" 在 "!" 前、"&&" ... （"&" 单独不合法，无所谓顺序）
//
//   我把 2 字符的运算符统一写在上半区、1 字符的写在下半区，靠肉眼就能校对。
//
symbol = _{
    eq | neq | le | ge | and | or
  | plus | minus | star | slash | percent
  | assign | lt | gt | not
  | l_paren | r_paren | l_brace | r_brace | l_brackt | r_brackt
  | comma | semicolon
}

eq        = { "==" }        // EQ
neq       = { "!=" }        // NEQ
le        = { "<=" }        // LE
ge        = { ">=" }        // GE
and       = { "&&" }        // AND
or        = { "||" }        // OR

plus      = { "+" }         // PLUS
minus     = { "-" }         // MINUS
star      = { "*" }         // MUL
slash     = { "/" }         // DIV
percent   = { "%" }         // MOD
assign    = { "=" }         // ASSIGN
lt        = { "<" }         // LT
gt        = { ">" }         // GT
not       = { "!" }         // NOT

l_paren   = { "(" }         // L_PAREN
r_paren   = { ")" }         // R_PAREN
l_brace   = { "{" }         // L_BRACE
r_brace   = { "}" }         // R_BRACE
l_brackt  = { "[" }         // L_BRACKT   （讲义拼写就是 BRACKT，照抄）
r_brackt  = { "]" }         // R_BRACKT
comma     = { "," }         // COMMA
semicolon = { ";" }         // SEMICOLON


// ----------------------------------------------------------------------------
// 5. 空白与注释：靠 pest 的"特殊规则"自动隐身
// ----------------------------------------------------------------------------
//
// 【要点】名字叫 WHITESPACE 和 COMMENT（全大写）的两条规则会被 pest 特殊对待：
//   任何 `{ }` / `${ }` 规则的序列元素之间，都会自动插入 (WHITESPACE | COMMENT)*。
//   也就是说——注释和空白**根本不会出现在 Pair 树里**，不用手写跳过逻辑。
//   这是本实验最省事的地方，别自己又去 if 判断一遍。
//
//   两个必须注意的点：
//   1. 用 `_` 修饰，否则它们会作为节点混进 Pair 树；用 `_` 后连节点都没有。
//   2. 这两个规则只对"普通规则/复合原子"生效。`@` 原子规则内部的相邻元素之间
//      **不会**自动跳空白 —— 所以 hex_int/oct_int 这类必须写成没有空格的紧邻形式。
//
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

COMMENT = _{ line_comment | block_comment }

// `//` 吃到行尾（不含换行符；换行交给 WHITESPACE 处理）
line_comment = @{ "//" ~ (!NEWLINE ~ ANY)* }

// `/* ... */`，靠 `!"*/"` 负向前瞻实现"非贪婪"，而不是真的非贪婪量词
block_comment = @{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
